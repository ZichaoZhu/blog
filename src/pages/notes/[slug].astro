---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "../../components/common/Markdown.astro";
import KatexManager from "../../components/features/KatexManager.astro";
import ArticleContents from "../../components/knowledge/ArticleContents.astro";
import ArticleMetadata from "../../components/knowledge/ArticleMetadata.astro";
import BackLink from "../../components/knowledge/BackLink.astro";
import KnowledgeContext from "../../components/knowledge/KnowledgeContext.astro";
import { siteConfig } from "../../config";
import { siteContext } from "../../config/siteContext";
import { courses } from "../../data/catalog";
import PaperTreeSection from "../../features/paper-trees/PaperTreeSection.astro";
import {
	getPublishedTree,
	studioEditorUrl,
	treeHeading,
} from "../../features/paper-trees/public-build";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import {
	asNoteRecord,
	getRoutablePosts,
	getSortedPosts,
} from "../../utils/content-utils";
import { getKnowledgeIndex } from "../../utils/knowledge-index";
import { getSidebarContext } from "../../utils/knowledge-model";
import { getCourseNeighbors } from "../../utils/note-model";
export async function getStaticPaths() {
	return (await getRoutablePosts()).map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}
const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const allRecords = (await getSortedPosts()).map(asNoteRecord);
const records = allRecords.filter((n) => n.data.type === "course");
const neighbors = getCourseNeighbors(records, entry.data.slug);
const course =
	entry.data.type === "course" && entry.data.course
		? courses.find((c) => c.id === entry.data.course?.id)
		: undefined;
const researchNote = ["log", "idea", "experiment"].includes(entry.data.type);
const backUrl = course
	? `/courses/${course.id}/`
	: entry.data.type === "paper"
		? "/papers/"
		: researchNote
			? "/research/"
			: "/notes/";
const backLabel =
	course?.title ??
	(entry.data.type === "paper" ? "论文" : researchNote ? "研究" : "全部笔记");
const sidebarContext = getSidebarContext(
	await getKnowledgeIndex(),
	Astro.url.pathname,
	{
		url: `/notes/${entry.data.slug}/`,
		type: entry.data.type,
		topics: entry.data.topics,
		course: entry.data.course,
	},
);
const paper = entry.data.paper;
const snapshot =
	entry.data.type === "paper"
		? await getPublishedTree(entry.data.id, allRecords)
		: undefined;
const analysisHeading = snapshot ? treeHeading(headings) : undefined;
const articleHeadings = analysisHeading
	? [analysisHeading, ...headings]
	: headings;
const editorUrl =
	entry.data.type === "paper"
		? studioEditorUrl(
				import.meta.env.PUBLIC_PAPER_TREE_STUDIO_ORIGIN,
				entry.data.id,
			)
		: null;
const sources = paper
	? [
			["论文", paper.paperUrl],
			["arXiv", paper.arxivUrl],
			["DOI", paper.doiUrl],
			["代码", paper.codeUrl],
			["查看论文解析树", paper.analysisUrl],
		].filter((s): s is [string, string] => !!s[1])
	: [];
const published = entry.data.visibility === "published";
const canonical = new URL(`/notes/${entry.data.slug}/`, siteConfig.site_url)
	.href;
const schema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description,
	url: canonical,
	author: {
		"@type": "Person",
		name: entry.data.author,
		url: new URL("/about/", siteConfig.site_url).href,
	},
	...(entry.data.date ? { datePublished: entry.data.date } : {}),
	...(entry.data.updatedAt ? { dateModified: entry.data.updatedAt } : {}),
};
---
<MainGridLayout hideHeading={true} title={entry.data.title} description={entry.data.description} postSlug={entry.data.slug} headings={articleHeadings} sidebarContext={sidebarContext} setOGTypeArticle={true}>
 <Fragment slot="head">
  {!published && !siteContext.noindex && <meta name="robots" content="noindex,follow"/>}
  {entry.data.date && <meta property="article:published_time" content={entry.data.date}/>}
  {entry.data.updatedAt && <meta property="article:modified_time" content={entry.data.updatedAt}/>}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/>
 </Fragment>
 <article class="card-base p-5 md:p-9 min-w-0" data-pagefind-body={published?true:undefined} data-pagefind-ignore={!published?'all':undefined}>
  {published&&<div hidden data-pagefind-ignore><span data-pagefind-filter={`type:${entry.data.type}`}/>{entry.data.topics.map(id=><span data-pagefind-filter={`topic:${id}`}/>)}{entry.data.course&&<span data-pagefind-filter={`course:${entry.data.course.id}`}/>}</div>}
  <nav aria-label="文章位置" class="article-position mb-5" data-pagefind-ignore>
   <BackLink href={backUrl} label={`返回${backLabel}`} ariaLabel={course?`返回课程：${course.title}`:`返回${backLabel}`}/>
   <a href="/topics/" class="btn-plain knowledge-action"><Icon name="material-symbols:category-outline-rounded" is:inline aria-hidden="true"/><span>浏览主题</span></a>
  </nav>
  <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4" data-pagefind-meta={published?'title':undefined} data-pagefind-weight="10">{entry.data.title}</h1>
  <p class="leading-relaxed mb-4">{entry.data.description}</p>
  <ArticleMetadata data={entry.data} words={remarkPluginFrontmatter.words} minutes={remarkPluginFrontmatter.minutes}/>
  <KnowledgeContext context={sidebarContext} location="inline"/>
  {paper && <section aria-label="论文资料" class="paper-details my-5" data-pagefind-ignore><h2 class="font-bold">论文资料</h2>{paper.title&&<p>{paper.title}</p>}{paper.authors?.length&&<p>{paper.authors.join(', ')}</p>}{(paper.venue||paper.year)&&<p>{paper.venue} {paper.year}</p>}<div class="collection-links">{sources.map(([label,url])=><a class="btn-plain knowledge-action" href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}</div></section>}
  {editorUrl&&<a href={editorUrl} class="btn-plain knowledge-action" data-pagefind-ignore rel="noopener noreferrer"><Icon name="material-symbols:edit-outline-rounded" is:inline aria-hidden="true"/><span>编辑解析树</span></a>}
  <ArticleContents headings={articleHeadings}/>
  {snapshot&&analysisHeading&&<PaperTreeSection snapshot={snapshot} anchor={analysisHeading.slug}/>}
  <Markdown class="mt-6"><Content/></Markdown>
 </article>
 {course&&(neighbors.previous||neighbors.next)&&<nav aria-label="上下讲" class="article-neighbors" data-pagefind-ignore>
  {neighbors.previous&&<a href={neighbors.previous.url} class="btn-card article-neighbor article-neighbor-previous" aria-label={`上一讲：${neighbors.previous.title}`} title={neighbors.previous.title}><Icon name="material-symbols:chevron-left-rounded" is:inline aria-hidden="true"/><span class="article-neighbor-copy"><span class="article-neighbor-label">上一讲</span><span class="article-neighbor-title">{neighbors.previous.title}</span></span></a>}
  {neighbors.next&&<a href={neighbors.next.url} class="btn-card article-neighbor article-neighbor-next" aria-label={`下一讲：${neighbors.next.title}`} title={neighbors.next.title}><span class="article-neighbor-copy"><span class="article-neighbor-label">下一讲</span><span class="article-neighbor-title">{neighbors.next.title}</span></span><Icon name="material-symbols:chevron-right-rounded" is:inline aria-hidden="true"/></a>}
 </nav>}
 <KatexManager/>
</MainGridLayout>
<style>
 .article-position{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.75rem;}
 .article-neighbors{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem;}
 .article-neighbor{justify-content:space-between;gap:1rem;min-width:0;min-height:88px;padding:1.1rem 1.25rem;border-radius:var(--radius-large);}
 .article-neighbor :global(svg){flex-shrink:0;color:var(--primary);font-size:var(--type-heading);}
 .article-neighbor-copy{display:grid;gap:.25rem;min-width:0;}
 .article-neighbor-label{font-size:var(--type-small);color:var(--content-meta);}
 .article-neighbor-title{font-size:var(--type-body);font-weight:700;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;}
 .article-neighbor-previous{text-align:left;}
 .article-neighbor-next{grid-column:2;text-align:right;}
 @media(max-width:640px){.article-neighbors{grid-template-columns:minmax(0,1fr);}.article-neighbor-next{grid-column:auto;}}
</style>
