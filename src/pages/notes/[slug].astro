---
import {render} from 'astro:content';
import MainGridLayout from '../../layouts/MainGridLayout.astro';
import Markdown from '../../components/common/Markdown.astro';
import KatexManager from '../../components/features/KatexManager.astro';
import {getRoutablePosts,getSortedPosts,asNoteRecord} from '../../utils/content-utils';
import {getCourseNeighbors,orderCourseNotes,toSummary} from '../../utils/note-model';
import {courses,topics} from '../../data/catalog';
import {siteConfig} from '../../config';
import {siteContext} from '../../config/siteContext';
export async function getStaticPaths(){return (await getRoutablePosts()).map(entry=>({params:{slug:entry.data.slug},props:{entry}}));}
const {entry}=Astro.props;
const {Content,headings,remarkPluginFrontmatter}=await render(entry);
const records=(await getSortedPosts()).map(asNoteRecord);
const neighbors=getCourseNeighbors(records,entry.data.slug);
const course=entry.data.course?courses.find(c=>c.id===entry.data.course?.id):undefined;
const courseContext=course?{courseId:course.id,currentSlug:entry.data.slug,notes:orderCourseNotes(records,course.id).map(toSummary)}:undefined;
const paper=entry.data.paper;
const sources=paper?[['论文',paper.paperUrl],['arXiv',paper.arxivUrl],['DOI',paper.doiUrl],['代码',paper.codeUrl]].filter((s):s is [string,string]=>!!s[1]):[];
const published=entry.data.visibility==='published';
const canonical=new URL(`/notes/${entry.data.slug}/`,siteConfig.site_url).href;
const schema={'@context':'https://schema.org','@type':'BlogPosting',headline:entry.data.title,description:entry.data.description,url:canonical,author:{'@type':'Person',name:entry.data.author,url:new URL('/about/',siteConfig.site_url).href},...(entry.data.date?{datePublished:entry.data.date}:{}),...(entry.data.updatedAt?{dateModified:entry.data.updatedAt}:{})};
---
<MainGridLayout hideHeading={true} title={entry.data.title} description={entry.data.description} postSlug={entry.data.slug} headings={headings} courseContext={courseContext} setOGTypeArticle={true}>
 <Fragment slot="head">
  {!published && !siteContext.noindex && <meta name="robots" content="noindex,follow"/>}
  {entry.data.date && <meta property="article:published_time" content={entry.data.date}/>}
  {entry.data.updatedAt && <meta property="article:modified_time" content={entry.data.updatedAt}/>}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/>
 </Fragment>
 <article class="card-base p-5 md:p-9 min-w-0" data-pagefind-body={published?true:undefined} data-pagefind-ignore={!published?'all':undefined}>
  {published&&<div hidden data-pagefind-ignore><span data-pagefind-filter={`type:${entry.data.type}`}/>{entry.data.topics.map(id=><span data-pagefind-filter={`topic:${id}`}/>)}{entry.data.course&&<span data-pagefind-filter={`course:${entry.data.course.id}`}/>}</div>}
  <nav aria-label="文章位置" class="collection-links text-sm mb-5" data-pagefind-ignore>
   {course ? <a href={`/courses/${course.id}/`}>{course.title} · 返回课程</a>:<a href={entry.data.type==='paper'?'/papers/':['log','idea','experiment'].includes(entry.data.type)?'/research/':'/notes/'}>← 返回集合</a>}
   <a href="/topics/">主题</a>
  </nav>
  <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4" data-pagefind-meta={published?'title':undefined} data-pagefind-weight="10">{entry.data.title}</h1>
  <p class="leading-relaxed mb-4">{entry.data.description}</p>
  <div class="note-context px-0" data-pagefind-ignore>
   <span>作者：{entry.data.author}</span>{entry.data.date?<time datetime={entry.data.date}>发布：{entry.data.date}</time>:<span>日期未记录</span>}{entry.data.updatedAt&&<time datetime={entry.data.updatedAt}>更新：{entry.data.updatedAt}</time>}
   <span>{remarkPluginFrontmatter.minutes} 分钟阅读</span>
  </div>
  <nav aria-label="文章主题" class="collection-links my-4" data-pagefind-ignore>{entry.data.topics.map(id=><a href={`/topics/${id}/`}>{topics.find(t=>t.id===id)?.name}</a>)}</nav>
  {paper && <section aria-label="论文资料" class="paper-details my-5" data-pagefind-ignore><h2 class="font-bold">论文资料</h2>{paper.title&&<p>{paper.title}</p>}{paper.authors?.length&&<p>{paper.authors.join(', ')}</p>}{(paper.venue||paper.year)&&<p>{paper.venue} {paper.year}</p>}<div class="collection-links">{sources.map(([label,url])=><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}</div></section>}
  {headings.length>0 && <details class="my-5 xl:hidden" data-pagefind-ignore><summary>文章目录</summary><nav aria-label="文章目录"><ol class="grid gap-2 p-3">{headings.map(h=><li style={`padding-left:${Math.max(0,h.depth-2)*.75}rem`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>}
  <Markdown class="mt-6"><Content/></Markdown>
  {course && <nav aria-label="上下讲" class="collection-links mt-8 pt-5 border-t border-(--line-divider)" data-pagefind-ignore>{neighbors.previous&&<a href={neighbors.previous.url}>← 上一讲：{neighbors.previous.title}</a>}{neighbors.next&&<a href={neighbors.next.url}>下一讲：{neighbors.next.title} →</a>}</nav>}
 </article>
 <KatexManager/>
</MainGridLayout>
