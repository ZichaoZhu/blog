---
import CollectionPage from "../../components/knowledge/CollectionPage.astro";
import { getKnowledgeIndex } from "../../utils/knowledge-index";
import { getCollectionPage } from "../../utils/knowledge-model";
export async function getStaticPaths() {
	const index = await getKnowledgeIndex();
	return ["logs", "ideas", "experiments"].map((type) => ({
		params: { type },
		props: {
			route: getCollectionPage(index.lists["/research/" + type + "/"], 1),
		},
	}));
}
const { route } = Astro.props;
---
<CollectionPage route={route} backUrl='/research/' backLabel='研究'/>
