---
import CollectionPage from "../../../../components/knowledge/CollectionPage.astro";
import { getKnowledgeIndex } from "../../../../utils/knowledge-index";
import { buildCollectionRoutes } from "../../../../utils/knowledge-model";
export async function getStaticPaths() {
	return buildCollectionRoutes(await getKnowledgeIndex())
		.filter(
			(r) =>
				[
					"/research/logs/",
					"/research/ideas/",
					"/research/experiments/",
				].includes(r.group.url) && r.page > 1,
		)
		.map((route) => ({
			params: { type: route.group.id, page: String(route.page) },
			props: { route },
		}));
}
const { route } = Astro.props;
---
<CollectionPage route={route} backUrl='/research/' backLabel='研究'/>
