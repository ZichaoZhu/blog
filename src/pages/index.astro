---
import NoteList from "../components/knowledge/NoteList.astro";
import TopicGroups from "../components/knowledge/TopicGroups.astro";
import KnowledgeLayout from "../layouts/KnowledgeLayout.astro";
import { asNoteRecord, getSortedPosts } from "../utils/content-utils";
import { getKnowledgeIndex } from "../utils/knowledge-index";
import type { HubId } from "../utils/knowledge-model";
import { toSummary } from "../utils/note-model";

const notes = (await getSortedPosts()).map((p) => toSummary(asNoteRecord(p)));
const featured = notes.filter((n) =>
	[
		"infinidepth-reading",
		"research-log-2026-07-07",
		"reinforcement-learning-lec2-bellman-equation",
	].includes(n.slug),
);
const index = await getKnowledgeIndex();
const entries: Array<[HubId, string, string]> = [
	["courses", "课程", "按课程与讲次系统阅读"],
	["papers", "论文", "论文阅读与方法理解"],
	["research", "研究", "日志、想法与实验"],
	["projects", "项目", "公开代码与阶段性成果"],
];
---
<KnowledgeLayout title="Goongmly Research Notes" description="课程笔记、论文阅读与科研记录。">
 <nav class="card-base p-6" aria-label="知识入口"><TopicGroups groups={entries.map(([id,title,description])=>({...index.hubs[id],title,description}))} class="knowledge-entries"/></nav>
 {featured.length>0 && <section><h2>精选阅读</h2><NoteList notes={featured}/></section>}
 <section><div class="section-heading"><h2>最近记录</h2><a class="btn-plain knowledge-action" href="/search/">搜索记录</a></div><NoteList notes={notes.slice(0,8)} /></section>
 <nav class="card-base p-6 collection-links" aria-label="更多入口"><a class="btn-plain knowledge-action" href="/topics/">按主题探索</a><a class="btn-plain knowledge-action" href="/about/">关于与联系</a></nav>
</KnowledgeLayout>
