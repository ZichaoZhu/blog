---
import BackLink from "@/components/knowledge/BackLink.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import KnowledgeLayout from "@/layouts/KnowledgeLayout.astro";
import { url } from "@/utils/url-utils";
---

<KnowledgeLayout title={`${i18n(I18nKey.notFound)} · ${i18n(I18nKey.notFoundTitle)}`} description={i18n(I18nKey.notFoundDescription)} directory>
 <BackLink href={url('/')} label={i18n(I18nKey.backToHome)}/>
</KnowledgeLayout>
