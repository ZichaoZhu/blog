---
import CollectionPage from '../../components/knowledge/CollectionPage.astro';
import {getKnowledgeIndex} from '../../utils/knowledge-index';
import {buildCollectionRoutes} from '../../utils/knowledge-model';
export async function getStaticPaths(){return buildCollectionRoutes(await getKnowledgeIndex()).filter(r=>r.page===1&&r.group.url.startsWith('/topics/')).map(route=>({params:{id:route.group.id},props:{route}}));}
const {route}=Astro.props;
---
<CollectionPage route={route} backUrl='/topics/' backLabel='全部主题'/>
