---
import KnowledgeLayout from "../../layouts/KnowledgeLayout.astro";
import { type CollectionRoute, type HubId } from "../../utils/knowledge-model";
import { toSummary } from "../../utils/note-model";
import { getFileDirFromPath, removeFileExtension } from "../../utils/url-utils";
import ProjectCard from "../pages/projects/ProjectCard.astro";
import CollectionPagination from "./CollectionPagination.astro";
import NoteList from "./NoteList.astro";

interface Props {
	route: CollectionRoute;
	backUrl: string;
	backLabel: string;
}
const { route, backUrl, backLabel } = Astro.props;
const hub = ["courses", "papers", "research", "projects"].find((h) =>
	route.group.url.startsWith(`/${h}/`),
) as HubId | undefined;
const notes = route.items.flatMap((item) =>
	item.kind === "post" ? [toSummary(item.post)] : [],
);
const projects = route.items.flatMap((item) =>
	item.kind === "project" ? [item.project] : [],
);
---
<KnowledgeLayout title={`${route.group.title}${route.page>1?` · 第 ${route.page} 页`:''}`} description={route.group.description}>
 <a href={backUrl} class="collection-back knowledge-action">← {backLabel}</a>
 <slot name="intro"/>
 <p class="collection-summary">{route.group.items.length} 篇公开记录</p>
 {(notes.length>0||projects.length===0)&&<NoteList notes={notes} hub={hub}/>}
 {projects.length>0&&<ul class="collection-list">{projects.map(project=><li><ProjectCard {...project.data} id={removeFileExtension(project.entryId)} basePath={getFileDirFromPath(project.filePath||'')}/></li>)}</ul>}
 <CollectionPagination baseUrl={route.group.url} page={route.page} totalPages={route.totalPages}/>
</KnowledgeLayout>
