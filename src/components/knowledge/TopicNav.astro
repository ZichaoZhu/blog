---
import type { SidebarContext } from "../../utils/knowledge-model";

interface Props {
	context: SidebarContext;
	id: string;
}
const { context, id } = Astro.props;
---
<nav id={id} class="topic-nav card-base p-4" aria-label={context.title} data-pagefind-ignore>
 <h2 class="font-bold mb-3">{context.title}</h2>
 {context.items.length?<ul>{context.items.map(item=><li><a href={item.url} aria-current={item.state==='current'?'page':undefined} data-related={item.state==='related'?true:undefined}><span>{item.title}</span><span class="topic-nav-count">{item.count}</span></a></li>)}</ul>:<p class="text-50">暂无主题</p>}
 {context.hub&&<a class="topic-nav-back" href={`/${context.hub}/`}>← 全部{context.hub==='courses'?'课程':context.hub==='papers'?'论文':context.hub==='research'?'研究':'项目'}</a>}
</nav>
