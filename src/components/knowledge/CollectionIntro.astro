---
import { getCollection, render } from "astro:content";
import { asNoteRecord } from "../../utils/content-utils";
import { isPublicCollection } from "../../utils/note-model";
import Markdown from "../common/Markdown.astro";

interface Props {
	slug: string;
}
const entry = (await getCollection("posts")).find(
	(p) =>
		isPublicCollection(asNoteRecord(p)) && p.data.slug === Astro.props.slug,
);
const rendered = entry?.body?.trim() ? await render(entry) : null;
const Content = rendered?.Content;
---
{Content&&<section class="card-base p-6" data-pagefind-ignore><Markdown class=""><Content/></Markdown></section>}
