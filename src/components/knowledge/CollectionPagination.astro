---
import { Icon } from "astro-icon/components";
import { collectionPageUrl } from "../../utils/knowledge-model";
import BackLink from "./BackLink.astro";

interface Props {
	baseUrl: string;
	page: number;
	totalPages: number;
}
const { baseUrl, page, totalPages } = Astro.props;
---
{totalPages>1 && <nav aria-label="分页" class="collection-pagination" data-pagefind-ignore>
 {page>1 && <BackLink href={collectionPageUrl(baseUrl,page-1)} label="上一页"/>}
 <span aria-current="page">{page} / {totalPages}</span>
 {page < totalPages && <a class="btn-plain knowledge-action" href={collectionPageUrl(baseUrl,page+1)}><span>下一页</span><Icon name="material-symbols:chevron-right-rounded" is:inline aria-hidden="true"/></a>}
</nav>}
