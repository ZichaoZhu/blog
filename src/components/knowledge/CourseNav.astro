---
import { courses } from "../../data/catalog";
import type { NoteSummary } from "../../utils/note-model";
import BackLink from "./BackLink.astro";

interface Props {
	courseId: string;
	currentSlug: string;
	notes: NoteSummary[];
}
const { courseId, currentSlug, notes } = Astro.props;
const course = courses.find((c) => c.id === courseId);
---
<nav aria-label="课程讲次" class="card-base p-4 course-nav" data-pagefind-ignore>
 <BackLink href={`/courses/${courseId}/`} label={`返回${course?.title ?? '课程'}`} ariaLabel={`返回课程：${course?.title ?? courseId}`} sidebar class="font-bold"/>
 <ol class="toc-content toc-scroll-container custom-scrollbar">{notes.map(note=><li><a class="toc-item sidebar-nav-item" href={note.url} aria-current={note.slug===currentSlug?'page':undefined}><span class="toc-badge toc-badge-index" aria-hidden="true">{note.course?.order ?? <span class="toc-badge-dot"/>}</span><span class="toc-label toc-label-primary">{note.title}</span></a></li>)}</ol>
</nav>
