---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";
import { getKnowledgeIndex } from "@/utils/knowledge-index";
import type { SiteStatsData } from "@/utils/knowledge-model";
import { activityText, getStatDates } from "@/utils/site-stats";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	stats?: SiteStatsData;
}
const { class: className, style, widgetConfig } = Astro.props;
const stats = Astro.props.stats ?? (await getKnowledgeIndex()).stats;
const startDay = siteConfig.siteStartDate || "2025-01-01";
const dates = getStatDates(startDay, stats.lastActivityISO);
const rows = [
	{
		id: "articles",
		label: "文章",
		icon: "material-symbols:article-outline",
		value: stats.articleCount,
	},
	{
		id: "categories",
		label: "分类",
		icon: "material-symbols:folder-outline",
		value: stats.categoryCount,
	},
	{
		id: "tags",
		label: "标签",
		icon: "material-symbols:label-outline",
		value: stats.tagCount,
	},
	{
		id: "words",
		label: "总字数",
		icon: "material-symbols:text-ad-outline-rounded",
		value: stats.totalWords,
	},
	{
		id: "running-days",
		label: "运行时长",
		icon: "material-symbols:calendar-clock-outline",
		value: dates.runningDays,
	},
];
---
<WidgetLayout name="站点统计" showTitle={widgetConfig?.showTitle!==false} id="site-stats" class={className} style={style}>
 <dl data-site-stats data-start-day={startDay} data-last-activity={stats.lastActivityISO??''} data-pagefind-ignore class="site-stat-list">
 {rows.map(row=><div><dt><Icon name={row.icon}/>{row.label}</dt><dd><span data-stat-id={row.id}>{row.value.toLocaleString('en-US')}</span>{row.id==='running-days'&&' 天'}</dd></div>)}
 <div><dt><Icon name="mingcute:heartbeat-line"/>最后活动</dt><dd><time data-stat-id="last-update" datetime={stats.lastActivityISO??undefined}>{activityText(dates)}</time></dd></div>
 </dl>
</WidgetLayout>
<script>
 import {getStatDates,activityText} from '@/utils/site-stats';
 function updateDates(){
  for(const root of document.querySelectorAll<HTMLElement>('[data-site-stats]')){
   const dates=getStatDates(root.dataset.startDay||'2025-01-01',root.dataset.lastActivity||null);
   const running=root.querySelector('[data-stat-id="running-days"]');
   const last=root.querySelector('[data-stat-id="last-update"]');
   if(running)running.textContent=dates.runningDays.toLocaleString('en-US');
   if(last)last.textContent=activityText(dates);
  }
 }
 updateDates();
 setInterval(updateDates,60000);
 document.addEventListener('swup:contentReplaced',updateDates);
 document.addEventListener('visibilitychange',()=>{if(!document.hidden)updateDates();});
</script>
<style>
 .site-stat-list{display:grid;gap:.9rem;font-size:var(--type-small);}
 .site-stat-list>div{display:flex;justify-content:space-between;gap:.5rem;}
 dt{display:flex;align-items:center;gap:.5rem;flex-shrink:0;}
 dt :global(svg){color:var(--primary);width:1.1rem;height:1.1rem;}
 dd{font-weight:600;font-size:var(--type-caption);text-align:right;overflow-wrap:anywhere;}
 time{font-weight:400;font-size:var(--type-caption);}
</style>
