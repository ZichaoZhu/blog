---
import { courses, topics } from "../../data/catalog";
import { getArchiveDate } from "../../utils/archive-model";
import { noteTypeLabels } from "../../utils/article-meta";
import { itemTopics, type KnowledgeItem } from "../../utils/knowledge-model";

interface Props {
	items: KnowledgeItem[];
}
const { items } = Astro.props;
const years = new Map<string, KnowledgeItem[]>();
for (const item of items) {
	const year = getArchiveDate(item)?.slice(0, 4) ?? "日期未记录";
	if (!years.has(year)) years.set(year, []);
	years.get(year)?.push(item);
}
---
<div class="archive-timeline" data-pagefind-ignore>
 {items.length ? Array.from(years, ([year, members]) => (
  <section class="archive-year" aria-label={year}>
   <header class="archive-year-heading"><h2>{year}</h2><span>本页 {members.length} 篇</span></header>
   <ol>
    {members.map(item => {
     const data = item.kind === "post" ? item.post.data : item.project.data;
     const date = getArchiveDate(item);
     const course = item.kind === "post" && item.post.data.type === "course" ? courses.find(c => c.id === item.post.data.course?.id) : undefined;
     const names = itemTopics(item).flatMap(id => topics.find(t => t.id === id)?.name ?? []);
     const subject = course?.title ?? [item.kind === "post" ? noteTypeLabels[item.post.data.type] : "项目", ...names].join(" · ");
     return <li><a href={item.url} class="toc-item sidebar-nav-item archive-post">
      {date ? <time class="archive-date" datetime={date} aria-label={date}>{date.slice(5)}</time> : <span class="archive-date">未记录</span>}
      <span class="archive-marker" aria-hidden="true"><span class="toc-badge toc-badge-dot"/></span>
      <span class="archive-content"><span class="archive-title">{data.title}</span><span class="archive-subject">{subject}</span></span>
     </a></li>;
    })}
   </ol>
  </section>
 )) : <p class="empty-state">暂无公开文章。</p>}
</div>
<style>
 .archive-timeline {display:grid;gap:1.5rem;min-width:0;}
 .archive-year-heading {display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:.5rem;}
 .archive-year-heading h2 {font-size:var(--type-heading);margin:0;}
 .archive-year-heading>span,.archive-date {font-size:var(--type-caption);color:var(--content-meta);font-variant-numeric:tabular-nums;}
 .archive-year ol {list-style:none;padding:0;margin:0;}
 .archive-post {display:grid;grid-template-columns:3.5rem 1rem minmax(0,1fr);min-height:60px;padding:.65rem .62rem;align-items:center;overflow:visible;}
 .archive-date {text-align:right;}
 .archive-marker {position:relative;align-self:stretch;display:flex;align-items:center;justify-content:center;}
 .archive-marker::before {content:"";position:absolute;top:-.65rem;bottom:-.65rem;left:50%;border-left:1px dashed var(--line-divider);}
 .archive-year li:first-child .archive-marker::before {top:50%;}
 .archive-year li:last-child .archive-marker::before {bottom:50%;}
 .archive-marker .toc-badge {position:relative;background:var(--primary);}
 .archive-content {display:flex;align-items:baseline;justify-content:space-between;gap:.5rem 1.25rem;min-width:0;}
 .archive-title {font-size:calc(var(--type-body) - 2px);font-weight:700;overflow-wrap:anywhere;line-height:1.6;}
 .archive-subject {font-size:var(--type-small);color:var(--content-meta);overflow-wrap:anywhere;line-height:1.5;flex-shrink:0;max-width:35%;text-align:right;}
 .archive-post:hover .archive-title,.archive-post:focus-visible .archive-title {color:var(--primary);}
 @media(max-width:767px) {
  .archive-post {grid-template-columns:2.75rem .75rem minmax(0,1fr);gap:.45rem;}
  .archive-content {display:grid;gap:.25rem;}
  .archive-subject {max-width:none;text-align:left;}
 }
</style>
